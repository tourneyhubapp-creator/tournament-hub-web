{
  "buildCommand": "npm run build --legacy-peer-deps",
  "outputDirectory": "dist",
  "env": {
    "VITE_API_URL": "https://api.tourneyhub.online"
  },
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "https://api.tourneyhub.online/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "methods": ["GET", "HEAD"]
    }
  ]
}
